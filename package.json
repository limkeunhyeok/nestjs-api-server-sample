{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 || >=24.11.1",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_OPTIONS=\"-r ./scripts/ts6-compat.cjs\" nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_OPTIONS=\"-r ./scripts/ts6-compat.cjs\" NODE_ENV=dev nest start",
    "start:dev": "cross-env NODE_OPTIONS=\"-r ./scripts/ts6-compat.cjs\" NODE_ENV=dev nest start --watch",
    "start:debug": "cross-env NODE_OPTIONS=\"-r ./scripts/ts6-compat.cjs\" NODE_ENV=dev nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/main",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "seed:dev": "cross-env NODE_ENV=dev ts-node -r tsconfig-paths/register src/seeds/runner.ts"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.5",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.1",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.7",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "joi": "^18.0.1",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "typeorm-transactional": "^0.5.0",
    "winston": "^3.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^11.11.0",
    "@testcontainers/redis": "^11.11.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/faker": "^5.5.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "faker": "^5.5.3",
    "husky": "^9.1.7",
    "oxlint": "^1.81.0",
    "pm2": "^6.0.13",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "pnpm": {
    "packageExtensions": {
      "jose": {
        "type": "module"
      }
    }
  }
}
